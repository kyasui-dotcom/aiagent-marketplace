{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiagent2",
  "main": "worker.js",
  "compatibility_date": "2026-04-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["* * * * *", "*/15 * * * *"]
  },
  "vars": {
    "PRIMARY_BASE_URL": "https://aiagent-marketplace.net",
    "BASE_URL": "https://aiagent-marketplace.net",
    "ALLOWED_BASE_URLS": "https://aiagent-marketplace.net,https://www.aiagent-marketplace.net,https://aiagent-market.net,https://aiagent2.net,https://aiagent2.yasuikunihiro.workers.dev",
    "SAMPLE_AGENT_ENDPOINT_BASE_URL": "https://aiagent-marketplace.net/sample-agents",
    "CAIT_DEVELOPER_API_ENABLED": "true",
    "CAIT_CLI_ENABLED": "true",
    "CAIT_MCP_ENABLED": "true",
    "OPEN_CHAT_ALLOW_PLATFORM_OPENAI_FALLBACK": "true",
    "SCHEDULED_BUILTIN_COMPLETION_SWEEP_LIMIT": "10",
    "BUILTIN_OPENAI_WORKFLOW_TIMEOUT_MS": "45000",
    "WORKFLOW_COMPLETION_SWEEP_STALE_MS": "900000",
    "WORKFLOW_SOURCE_COLLECTION_TIMEOUT_MS": "60000",
    "WORKFLOW_SOURCE_COLLECTION_MAX_RETRIES": "10",
    "LEADER_PLANNER_TIMEOUT_MS": "30000",
    "WORKFLOW_DISPATCH_MAX_AGE_MS": "86400000",
    "WORKFLOW_TIMEOUT_RETRY_SWEEP_LIMIT": "10",
    "WORKFLOW_ORCHESTRATION_WATCHDOG_LIMIT": "20",
    "WORKFLOW_ORCHESTRATION_STALE_MS": "60000",
    "WORKFLOW_ORCHESTRATION_BLOCKED_MS": "600000",
    "QUEUED_DISPATCH_SWEEP_LIMIT": "12",
    "ADMIN_DASHBOARD_LOGINS": "yasuikunihiro@gmail.com,e2e@aiagent-marketplace.net",
    "FEEDBACK_EMAIL_TO": "support@aiagent-marketplace.net",
    "FEEDBACK_EMAIL_DELIVERY_TO": "yasuikunihiro@gmail.com",
    "FEEDBACK_EMAIL_FROM": "support@aiagent-marketplace.net"
  },
  "send_email": [
    {
      "name": "FEEDBACK_EMAIL",
      "destination_address": "yasuikunihiro@gmail.com"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "aiagent2-workflow-dispatch",
        "binding": "WORKFLOW_DISPATCH_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "aiagent2-workflow-dispatch",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 120
      }
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "MY_BINDING",
      "database_name": "aiagent2",
      "database_id": "6de97816-9a66-4d39-8e89-5bbb741bd360"
    }
  ]
}
